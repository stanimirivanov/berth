+import { createHash } from "node:crypto";
+import { expect, test } from "@playwright/test";
+
+const defaultMotion = process.env.BERTH_QUALIFICATION_DEFAULT_MOTION === "1";
+const operation = "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa";
+const record = {
+  operation,
+  startedAt: "2026-11-20T06:50:00Z",
+  expiresAt: "2026-11-20T10:50:00Z",
+  outcome: "succeeded",
+  phase: "cleanup",
+  pendingUpload: false,
+  cleanupRequested: true,
+  objectRemoved: true,
+  verdict: "partial",
+  budgets: {
+    normal: { used: 15, limit: 160 },
+    cleanup: { used: 14, limit: 40 },
+    monitoring: { used: 0, limit: 20 },
+    neon: { used: 7, limit: 100 },
+  },
+  unresolved: { requests: 0, mutations: 0 },
+};
+
+/** Collect only CSP directive names and element names for the synthetic run. */
+test("Material history access and progress obey the native static CSP", async ({
+  page,
+}) => {
+  await page.addInitScript(() => {
+    const evidence = document.createElement("template");
+    evidence.id = "qualification-evidence";
+    document.addEventListener("DOMContentLoaded", () =>
+      document.head.append(evidence),
+    );
+    document.addEventListener("securitypolicyviolation", (event) => {
+      evidence.content.append(`${event.effectiveDirective}\n`);
+    });
+  });
+  const detailReply = Promise.withResolvers<void>();
+  const injected = new Set<string>();
+  const reads: string[] = [];
+  const externalRequests: string[] = [];
+  const pageErrors: string[] = [];
+  page.on("pageerror", (error) => pageErrors.push(error.message));
+  await page.route(
+    (url) => url.hostname !== "127.0.0.1",
+    (route) => route.abort(),
+  );
+  page.on("request", (request) => {
+    const url = new URL(request.url());
+    if (url.hostname !== "127.0.0.1") externalRequests.push(url.origin);
+  });
+  await page.route("**/api/history**", async (route) => {
+    const path = new URL(route.request().url()).pathname;
+    reads.push(path);
+    expect(route.request().headers().authorization).toBe(
+      `Bearer ${"h".repeat(40)}`,
+    );
