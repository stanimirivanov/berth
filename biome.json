{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "formatter": {
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noCommonJs": "error",
            "noNamespace": "error",
            "useConst": "error",
            "useExportType": "error",
            "useImportType": "error"
          },
          "suspicious": {
            "noConstEnum": "error",
            "noVar": "error"
          }
        }
      }
    }
  ]
}
