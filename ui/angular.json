{
  "version": 1,
  "projects": {
    "history": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "berth",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.json",
            "outputPath": "dist/history",
            "styles": ["src/styles.css", "src/material-theme.scss"],
            "assets": [
              {
                "glob": "*",
                "input": "public",
                "output": "/"
              }
            ]
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "600kB",
                  "maximumError": "1MB"
                }
              ],
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": false
              }
            },
            "read-only": {
              "outputPath": "dist/read-only",
              "fileReplacements": [
                {
                  "replace": "src/operation-history/retry/retry-panel.ts",
                  "with": "src/operation-history/read-only/retry-panel.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "history:build"
          }
        }
      }
    }
  }
}
