{
  "name": "berth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": "24.22.3",
    "pnpm": "12.16.1"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && pnpm run typecheck:harness",
    "lint": "biome check scripts tests src neon.ts package.json tsconfig.json biome.json && pnpm run lint:harness",
    "test": "pnpm run build && node --test dist/tests/*.test.js && pnpm run test:harness",
    "test:smoke": "pnpm run build && node --test dist/tests/runtime-smoke.test.js",
    "neon": "neon",
    "setup:neon": "pnpm run build && node dist/scripts/neon-setup.js",
    "test:setup-db": "pnpm run build && node --test dist/tests/integration/neon-database.test.js",
    "setup:oci": "pnpm run build && node dist/scripts/oci-setup.js",
    "test:oci-setup": "pnpm run build && node --test dist/tests/oci-setup.test.js dist/tests/oci-admin.test.js dist/tests/oci-recovery.test.js dist/tests/oci-diagnostics.test.js",
    "setup:oci-admin": "pnpm run build && node dist/scripts/oci-admin-setup.js",
    "doctor:oci": "pnpm run build && node dist/scripts/oci-doctor.js",
    "test:oci-doctor": "pnpm run build && node --test dist/tests/oci-doctor.test.js",
    "test:runtime-probe": "pnpm run build && node --test dist/tests/runtime-probe.test.js",
    "build:runtime-probe": "pnpm run build && node dist/scripts/build-runtime-probe.js",
    "lint:harness": "biome check tools tests/*.mjs tsconfig.harness.json",
    "typecheck:harness": "tsc -p tsconfig.harness.json",
    "test:harness": "node --test tests/*.test.mjs",
    "harness": "node tools/harness.mjs",
    "floor": "node tools/floor.mjs",
    "secrets": "node tools/secrets.mjs",
    "security": "pnpm run secrets && pnpm audit --audit-level high",
    "check:fast": "pnpm run floor && pnpm run lint && pnpm run typecheck && pnpm run harness",
    "check": "pnpm run check:fast && pnpm test && pnpm run build:runtime-probe && pnpm run security",
    "test:state-db": "pnpm run build && node --test dist/tests/integration/state-contract.test.js",
    "test:cloudflare-trial": "pnpm run build && node --test dist/tests/cloudflare-trial.test.js dist/tests/cloudflare-state-probe.test.js",
    "build:state-probe": "pnpm run build && node dist/scripts/build-state-probe.js",
    "test:fenced-db": "pnpm run build && node --test dist/tests/integration/fenced-state.test.js",
    "test:checkpoint-db": "pnpm run build && node --test dist/tests/integration/checkpoint.test.js",
    "build:checkpoint": "pnpm run build && node dist/scripts/build-checkpoint.js",
    "test:ledger-db": "pnpm run build && node --test dist/tests/integration/ledger.test.js",
    "test:executor-db": "pnpm run build && node --test dist/tests/integration/executor.test.js",
    "build:executor": "pnpm run build && node dist/scripts/build-executor.js",
    "test:usage-db": "pnpm run build && node --test dist/tests/integration/usage.test.js"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.4",
    "alchemy": "2.0.0-beta.86",
    "effect": "4.1.4",
    "oci-common": "2.146.0",
    "oci-objectstorage": "2.146.0"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.86",
    "@alchemy.run/sql": "2.0.0-beta.86",
    "@biomejs/biome": "2.6.7",
    "@effect/sql-pg": "4.1.4",
    "@neon/config-runtime": "1.12.3",
    "@types/node": "24.19.2",
    "@types/node-fetch": "2.6.13",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "neon": "9.4.0",
    "pg": "8.23.1",
    "typescript": "7.0.2",
    "typescript-ast": "npm:typescript@5.9.3",
    "yaml": "2.9.1"
  }
}
