{
  "name": "berth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": "24.22.3",
    "pnpm": "12.16.1"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && pnpm run typecheck:harness && pnpm run typecheck:pages && pnpm run typecheck:playwright",
    "typecheck:pages": "pnpm --dir ui exec tsc -p tsconfig.pages.json",
    "typecheck:playwright": "pnpm --dir ui exec tsc -p tsconfig.playwright.json",
    "lint": "biome check scripts tests src neon.ts package.json tsconfig.json biome.json && pnpm run lint:harness && pnpm run lint:spacing && pnpm run lint:ui",
    "test": "pnpm run build && node --test dist/tests/*.test.js && pnpm run test:harness",
    "test:smoke": "pnpm run build && node --test dist/tests/runtime-smoke.test.js",
    "neon": "neon",
    "setup:neon": "pnpm run build && node dist/scripts/neon-setup.js",
    "test:setup-db": "pnpm run build && node --test dist/tests/integration/neon-database.test.js",
    "setup:oci": "pnpm run build && node dist/scripts/oci-setup.js",
    "test:oci-setup": "pnpm run build && node --test dist/tests/oci-setup.test.js dist/tests/oci-admin.test.js dist/tests/oci-recovery.test.js dist/tests/oci-diagnostics.test.js",
    "setup:oci-admin": "pnpm run build && node dist/scripts/oci-admin-setup.js",
    "doctor:oci": "pnpm run build && node dist/scripts/oci-doctor.js",
    "test:oci-doctor": "pnpm run build && node --test dist/tests/oci-doctor.test.js",
    "test:runtime-probe": "pnpm run build && node --test dist/tests/runtime-probe.test.js",
    "build:runtime-probe": "pnpm run build && node dist/scripts/build-runtime-probe.js",
    "lint:harness": "biome check tools tests/*.mjs tsconfig.harness.json",
    "typecheck:harness": "tsc -p tsconfig.harness.json",
    "test:harness": "node --test tests/*.test.mjs",
    "harness": "node tools/harness.mjs",
    "floor": "node tools/floor.mjs",
    "secrets": "node tools/secrets.mjs",
    "security": "pnpm run secrets && pnpm audit --audit-level high",
    "check:fast": "pnpm run floor && pnpm run lint && pnpm run typecheck && pnpm run harness",
    "check": "pnpm run check:fast && pnpm test && pnpm run build:runtime-probe && pnpm run security && pnpm run check:ui",
    "test:state-db": "pnpm run build && node --test dist/tests/integration/state-contract.test.js",
    "test:cloudflare-trial": "pnpm run build && node --test dist/tests/cloudflare-trial.test.js dist/tests/cloudflare-state-probe.test.js",
    "build:state-probe": "pnpm run build && node dist/scripts/build-state-probe.js",
    "test:fenced-db": "pnpm run build && node --test dist/tests/integration/fenced-state.test.js",
    "test:checkpoint-db": "pnpm run build && node --test dist/tests/integration/checkpoint.test.js",
    "build:checkpoint": "pnpm run build && node dist/scripts/build-checkpoint.js",
    "test:ledger-db": "pnpm run build && node --test dist/tests/integration/ledger.test.js",
    "test:executor-db": "pnpm run build && node --test dist/tests/integration/executor.test.js",
    "build:executor": "pnpm run build && node dist/scripts/build-executor.js",
    "test:usage-db": "pnpm run build && node --test dist/tests/integration/usage.test.js",
    "test:recovery-db": "pnpm run build && node --test --test-concurrency=1 dist/tests/integration/recovery.test.js dist/tests/integration/security.test.js",
    "build:live-executor": "pnpm run build && node dist/scripts/build-live-executor.js",
    "inventory:record-owner": "pnpm run build && node dist/scripts/inventory-owner-receipt.js",
    "test:retry-db": "pnpm run build && node --test dist/tests/integration/retry.test.js",
    "build:retry": "pnpm run build && node dist/scripts/build-retry.js",
    "test:inventory-db": "pnpm run build && node --test dist/tests/integration/inventory.test.js",
    "test:admission-db": "pnpm run build && node --test dist/tests/integration/admission.test.js",
    "lint:spacing": "eslint scripts tests src tools neon.ts eslint.config.mjs",
    "security:temporary-audit": "pnpm run secrets && node dist/scripts/temporary-audit.js",
    "check:temporary-audit": "pnpm run check:fast && pnpm test && pnpm run build:runtime-probe && pnpm run security:temporary-audit && pnpm run check:ui",
    "ui:install": "pnpm --dir ui install --frozen-lockfile",
    "build:ui": "pnpm --dir ui build",
    "build:ui:read-only": "pnpm --dir ui build:read-only",
    "test:ui": "pnpm --dir ui test",
    "test:ui:read-only": "pnpm --dir ui test:read-only",
    "history:serve": "pnpm build && node dist/scripts/history-server.js",
    "build:history": "pnpm build && node dist/scripts/build-history.js",
    "build:inventory": "pnpm build && node dist/scripts/build-inventory.js",
    "lint:ui": "biome check ui/src ui/tests ui/*.ts ui/*.json && eslint ui/src ui/tests ui/*.ts && pnpm run lint:history-edge && pnpm run lint:angular && pnpm run lint:contracts",
    "check:ui": "pnpm build:ui && pnpm build:history && pnpm test:ui && pnpm --dir ui audit --audit-level high && pnpm run check:ui:read-only",
    "check:ui:read-only": "pnpm build:ui:read-only && pnpm test:ui:read-only",
    "lint:angular": "biome check ui/eslint.angular.mjs && eslint --config ui/eslint.angular.mjs \"ui/src/**/*.ts\" \"ui/src/**/*.html\"",
    "lint:history-edge": "biome check ui/edge ui/functions ui/public/_routes.json && eslint ui/edge ui/functions",
    "build:oci-storage": "pnpm build && node dist/scripts/build-oci-storage.js",
    "lint:contracts": "biome check ui/contracts && eslint ui/contracts",
    "test:oci-storage-db": "pnpm run build && node --test dist/tests/integration/oci-storage.test.js"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.4",
    "alchemy": "2.0.0-beta.86",
    "effect": "4.1.4",
    "oci-common": "2.146.0",
    "oci-objectstorage": "2.146.0"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.86",
    "@alchemy.run/sql": "2.0.0-beta.86",
    "@babel/core": "8.1.2",
    "@babel/eslint-parser": "8.1.2",
    "@biomejs/biome": "2.6.7",
    "@effect/sql-pg": "4.1.4",
    "@neon/config-runtime": "1.12.3",
    "@stylistic/eslint-plugin": "6.0.0",
    "@types/node": "24.19.2",
    "@types/node-fetch": "2.6.13",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "eslint": "10.15.0",
    "neon": "9.4.0",
    "pg": "8.23.1",
    "typescript": "7.0.2",
    "typescript-ast": "npm:typescript@5.9.3",
    "yaml": "2.9.1"
  }
}
