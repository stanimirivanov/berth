{
  "name": "berth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": "24.22.3",
    "pnpm": "12.16.1"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "biome check scripts tests package.json tsconfig.json biome.json",
    "test": "pnpm run build && node --test dist/tests/*.test.js",
    "test:smoke": "pnpm run build && node --test dist/tests/runtime-smoke.test.js",
    "neon": "neon",
    "setup:neon": "pnpm run build && node dist/scripts/neon-setup.js",
    "test:setup-db": "pnpm run build && node --test dist/tests/integration/neon-database.test.js",
    "setup:oci": "pnpm run build && node dist/scripts/oci-setup.js",
    "test:oci-setup": "pnpm run build && node --test dist/tests/oci-setup.test.js dist/tests/oci-admin.test.js",
    "setup:oci-admin": "pnpm run build && node dist/scripts/oci-admin-setup.js"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.4",
    "alchemy": "2.0.0-beta.86",
    "effect": "4.1.4",
    "oci-common": "2.146.0",
    "oci-objectstorage": "2.146.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "24.19.2",
    "@types/node-fetch": "2.6.13",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "neon": "9.4.0",
    "pg": "8.23.1",
    "typescript": "7.0.2"
  }
}
